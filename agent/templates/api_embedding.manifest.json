{
  "name": "@@DPK_NAME@@",
  "displayName": "@@DISPLAY_NAME@@",
  "version": "@@VERSION@@",
  "scope": "public",
  "description": "@@DESCRIPTION@@",
  "attributes": {
    "Category": ["Model", "NIM"],
    "NLP": "Embeddings",
    "Provider": "@@PROVIDER@@",
    "Media Type": ["Text"],
    "Hub": ["Nvidia", "Dataloop"],
    "Deployed By": "NVIDIA",
    "License": "@@LICENSE@@"
  },
  "components": {
    "computeConfigs": [
      {
        "name": "@@DPK_NAME@@-deploy",
        "runtime": {
          "podType": "regular-xs",
          "concurrency": 1,
          "autoscaler": {
            "type": "rabbitmq",
            "minReplicas": 0,
            "maxReplicas": 2,
            "queueLength": 100
          },
          "runnerImage": "@@RUNNER_IMAGE@@"
        }
      }
    ],
    "modules": [
      {
        "name": "@@DPK_NAME@@-module",
        "entryPoint": "models/api/embeddings/base.py",
        "className": "ModelAdapter",
        "computeConfig": "@@DPK_NAME@@-deploy",
        "description": "@@ADAPTER_DESC@@",
        "initInputs": [{ "type": "Model", "name": "model_entity" }],
        "functions": [
          {
            "name": "embed_items",
            "input": [
              { "type": "Item[]", "name": "items", "description": "The input items for embeddings." }
            ],
            "output": [
              { "type": "Item[]", "name": "items", "description": "The same input items for embeddings." },
              { "type": "Json", "name": "json", "description": "Embeddings of items." }
            ],
            "displayName": "Embed Items",
            "displayIcon": "",
            "description": "The inference function of the model."
          },
          {
            "name": "embed_dataset",
            "input": [
              { "type": "Dataset", "name": "dataset", "description": "The input dataset of the items required for prediction." },
              { "type": "Json", "name": "filters", "description": "The DQL in json format to get all the items required for prediction." }
            ],
            "output": [],
            "displayName": "Embed Dataset",
            "displayIcon": "",
            "description": "Inference function of the model on a dataset."
          }
        ],
        "integrations": ["dl-ngc-api-key"]
      }
    ],
    "models": [
      {
        "name": "@@DPK_NAME@@",
        "moduleName": "@@DPK_NAME@@-module",
        "scope": "project",
        "status": "pre-trained",
        "inputType": "text",
        "description": "@@ADAPTER_DESC@@",
        "configuration": {
          "nim_model_name": "@@MODEL_ID@@",
          "embeddings_size": 1024,
          "hyde_model_name": "",
          "base_url": "https://integrate.api.nvidia.com/v1"
        }
      }
    ]
  },
  "codebase": {
    "type": "git",
    "gitUrl": "https://github.com/dataloop-ai-apps/nim-api-adapter",
    "gitTag": "@@GIT_TAG@@"
  }
}
