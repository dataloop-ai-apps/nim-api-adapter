{
  "name": "nemotron-graphic-elements-v1",
  "displayName": "nemotron-graphic-elements-v1",
  "version": "0.3.64",
  "scope": "public",
  "description": "Nemotron Graphic Elements v1 - YOLOX-based object detection model for identifying and extracting key elements from charts and graphs, served by NIM API. License: NVIDIA Evaluation License Agreement",
  "attributes": {
    "Hub": [
      "Nvidia",
      "Dataloop"
    ],
    "Provider": "Other",
    "Deployed By": "NVIDIA",
    "Category": [
      "Model",
      "NIM"
    ],
    "Computer Vision": "Object Detection",
    "Media Type": [
      "Image"
    ],
    "License": "NVIDIA Evaluation License Agreement"
  },
  "codebase": {
    "type": "git",
    "gitUrl": "https://github.com/dataloop-ai-apps/nim-api-adapter",
    "gitTag": "0.3.64"
  },
  "components": {
    "computeConfigs": [
      {
        "name": "nim-api-deploy",
        "runtime": {
          "podType": "regular-xs",
          "concurrency": 1,
          "runnerImage": "gcr.io/viewo-g/piper/agent/runner/apps/nim-api-adapter:0.3.43",
          "autoscaler": {
            "type": "rabbitmq",
            "minReplicas": 0,
            "maxReplicas": 2
          }
        }
      }
    ],
    "modules": [
      {
        "name": "nim-api-module",
        "entryPoint": "models/api/object_detection/base.py",
        "className": "ModelAdapter",
        "computeConfig": "nim-api-deploy",
        "description": "NIM API Adapter for Nemotron Graphic Elements v1 model detecting chart and graph elements.",
        "integrations": [
          "dl-ngc-api-key"
        ],
        "initInputs": [
          {
            "type": "Model",
            "name": "model_entity"
          }
        ],
        "functions": [
          {
            "name": "predict_items",
            "input": [
              {
                "type": "Item[]",
                "name": "items",
                "description": "List of items to run inference on"
              }
            ],
            "output": [
              {
                "type": "Item[]",
                "name": "items",
                "description": "The same input images for prediction."
              },
              {
                "type": "Annotation[]",
                "name": "annotations",
                "description": "The predicted annotations."
              }
            ],
            "displayName": "Predict Items",
            "displayIcon": "",
            "description": "Predict items using Nemotron Graphic Elements v1 model via NIM API."
          }
        ]
      }
    ],
    "models": [
      {
        "name": "nemotron-graphic-elements-v1",
        "moduleName": "nim-api-module",
        "scope": "project",
        "status": "pre-trained",
        "configuration": {
          "nim_model_name": "cv/nvidia/nemotron-graphic-elements-v1"
        },
        "description": "Nemotron Graphic Elements v1 model for chart and graph element detection, served by NIM API."
      }
    ]
  }
}
